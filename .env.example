# Resend API key (required for emails). Without it, emails are logged to the console instead.
# https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Firebase service account (required for referral tracking in production).
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the ENTIRE downloaded JSON on one line as the value.
# Locally you can instead drop the file at ./firebase-service-account.json (gitignored).
FIREBASE_SERVICE_ACCOUNT=

# Shared secret for /admin and /api/admin/*. Generate with: openssl rand -hex 32
ADMIN_TOKEN=change_me

# Local development only: point at the Firestore emulator (npm run emulator).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-miraistack
