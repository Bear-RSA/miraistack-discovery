rules_version = '2';

// All reads and writes go through the Next.js server with the Admin SDK,
// which bypasses these rules. Nothing should ever talk to Firestore from a
// browser, so deny everything at the client level.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
